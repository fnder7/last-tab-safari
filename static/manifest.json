{
  "manifest_version": 3,
  "name": "Last Tab",
  "version": "1.0.0",
  "description": "Switch to the previously active tab with a keyboard shortcut.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "images/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
