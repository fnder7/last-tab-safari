{
  "manifest_version": 3,
  "name": "Last Tab",
  "version": "1.0.0",
  "description": "Cmd-Tab style switcher for the tabs of the current Safari window.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "icons": {
    "128": "images/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
