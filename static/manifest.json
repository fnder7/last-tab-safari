{
  "manifest_version": 3,
  "name": "Last Tab",
  "version": "2.1.1",
  "description": "Cmd-Tab style switcher for the tabs of the current Safari window.",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "action": {
    "default_title": "Last Tab",
    "default_popup": "options.html",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "19": "images/toolbar-19.png",
      "32": "images/toolbar-32.png",
      "38": "images/toolbar-38.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html"
  }
}
